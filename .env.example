# --- AI: Claude on AWS Bedrock ---
AWS_REGION=us-east-1
# Copy the exact model ID (or inference profile ID) from the Bedrock console
BEDROCK_MODEL_ID=
# Option 1: Bedrock API key (bearer token)
BEDROCK_API_KEY=
# Option 2: IAM access keys (leave BEDROCK_API_KEY empty to use these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
